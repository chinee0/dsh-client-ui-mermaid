{
    "name":  "@deepseek-ai/dsh-client-ui-mermaid",
    "description":  "Mermaid preview for markdown fences: keeps the source, opens the rendered diagram in a right-edge panel",
    "version":  "0.1.0-rc.8",
    "private":  true,
    "type":  "module",
    "main":  "lib/index.js",
    "types":  "lib/types/index.d.ts",
    "exports":  {
                    ".":  {
                              "types":  "./lib/types/index.d.ts",
                              "default":  "./lib/index.js"
                          },
                    "./client":  {
                                     "types":  "./lib/types/client/index.d.ts",
                                     "default":  "./lib/client.js"
                                 },
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg",
                    "./src/*":  "./src/*",
                    "./package.json":  "./package.json"
                },
    "files":  [
                  "lib/**",
                  "cordis.patch.yml",
                  "locale/*.json",
                  "icon.svg"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true
                           }
            },
    "scripts":  {
                    "bundle":  "tsdown",
                    "watch":  "tsdown --watch"
                },
    "license":  "MIT",
    "dependencies":  {
                         "mermaid":  "11.16.0"
                     },
    "peerDependencies":  {
                             "@deepseek-ai/cordis":  "workspace:^"
                         },
    "devDependencies":  {
                            "@deepseek-ai/cordis":  "workspace:^"
                        },
    "repository":  "git+https://github.com/chinee0/dsh-client-ui-mermaid.git",
    "homepage":  "https://github.com/chinee0/dsh-client-ui-mermaid#readme",
    "bugs":  {
                 "url":  "https://github.com/chinee0/dsh-client-ui-mermaid/issues"
             },
    "keywords":  [
                     "deepseek-harness",
                     "dsh",
                     "dsh-plugin",
                     "mermaid",
                     "diagram",
                     "markdown"
                 ]
}
